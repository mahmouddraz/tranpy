<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="German transmission grid model" version="3.34.0-Prizren">
  <homePath path="" />
  <title>German transmission grid model</title>
  <projectCrs>
    <spatialrefsys nativeFormat="Wkt">
      <proj4>+proj=merc +a=6378137 +b=6378137 +lat_ts=0 +lon_0=0 +x_0=0 +y_0=0 +k=1 +units=m +nadgrids=@null +wktext +no_defs</proj4>
      <srid>3857</srid>
      <authid>EPSG:3857</authid>
      <description>WGS 84 / Pseudo-Mercator</description>
      <projectionacronym>merc</projectionacronym>
      <ellipsoidacronym>EPSG:7030</ellipsoidacronym>
      <geographicflag>false</geographicflag>
    </spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <customproperties />
    <layer-tree-layer id="neighbours_grid_model" name="Neighbouring networks" source="./grid_model.gpkg|layername=neighbours" providerKey="ogr" checked="Qt::Checked" expanded="0" />
    <layer-tree-layer id="plants_grid_model" name="Power plants (MaStR)" source="./grid_model.gpkg|layername=plants" providerKey="ogr" checked="Qt::Checked" expanded="0" />
    <layer-tree-layer id="plant_aggregates_grid_model" name="Small plants (summed per bus and fuel)" source="./grid_model.gpkg|layername=plant_aggregates" providerKey="ogr" checked="Qt::Checked" expanded="0" />
    <layer-tree-layer id="station_transformers_grid_model" name="Transformers in stations" source="./grid_model.gpkg|layername=station_transformers" providerKey="ogr" checked="Qt::Checked" expanded="0" />
    <layer-tree-layer id="transformers_grid_model" name="Transformers" source="./grid_model.gpkg|layername=transformers" providerKey="ogr" checked="Qt::Checked" expanded="0" />
    <layer-tree-layer id="substations_grid_model" name="Substations" source="./grid_model.gpkg|layername=substations" providerKey="ogr" checked="Qt::Checked" expanded="0" />
    <layer-tree-layer id="buses_grid_model" name="Buses (model / ANDES ids)" source="./grid_model.gpkg|layername=buses" providerKey="ogr" checked="Qt::Unchecked" expanded="0" />
    <layer-tree-layer id="station_levels_grid_model" name="Station voltage levels" source="./grid_model.gpkg|layername=station_levels" providerKey="ogr" checked="Qt::Checked" expanded="0" />
    <layer-tree-layer id="lines_grid_model" name="Lines (AC circuits, HVDC)" source="./grid_model.gpkg|layername=lines" providerKey="ogr" checked="Qt::Checked" expanded="0" />
    <layer-tree-layer id="station_footprints_grid_model" name="Station footprints" source="./grid_model.gpkg|layername=station_footprints" providerKey="ogr" checked="Qt::Checked" expanded="0" />
    <layer-tree-layer id="tower_lines_grid_model" name="Tower lines (OpenStreetMap)" source="./grid_model.gpkg|layername=tower_lines" providerKey="ogr" checked="Qt::Checked" expanded="0" />
    <layer-tree-layer id="plant_connections_grid_model" name="Plant connections" source="./grid_model.gpkg|layername=plant_connections" providerKey="ogr" checked="Qt::Checked" expanded="0" />
    <layer-tree-layer id="control_areas_grid_model" name="TSO control areas (approximate)" source="./grid_model.gpkg|layername=control_areas" providerKey="ogr" checked="Qt::Checked" expanded="0" />
    <layer-tree-layer id="bidding_zones_grid_model" name="Bidding zones" source="./grid_model.gpkg|layername=bidding_zones" providerKey="ogr" checked="Qt::Checked" expanded="0" />
    <layer-tree-layer id="basemap_carto_positron" name="CARTO Positron (no labels)" source="" providerKey="wms" checked="Qt::Checked" expanded="0" />
  </layer-tree-group>
  <projectlayers>
    <maplayer type="vector" geometry="Line" hasScaleBasedVisibilityFlag="0" minScale="100000000" maxScale="0" labelsEnabled="1" readOnly="0">
      <id>lines_grid_model</id>
      <datasource>./grid_model.gpkg|layername=lines</datasource>
      <layername>Lines (AC circuits, HVDC)</layername>
      <srs>
        <spatialrefsys nativeFormat="Wkt">
          <proj4>+proj=longlat +datum=WGS84 +no_defs</proj4>
          <srid>4326</srid>
          <authid>EPSG:4326</authid>
          <description>WGS 84</description>
          <projectionacronym>longlat</projectionacronym>
          <ellipsoidacronym>EPSG:7030</ellipsoidacronym>
          <geographicflag>true</geographicflag>
        </spatialrefsys>
      </srs>
      <provider encoding="UTF-8">ogr</provider>
      <renderer-v2 type="RuleRenderer" symbollevels="0" enableorderby="0" forceraster="0" referencescale="-1">
              <rules key="{root}">
                <rule key="{r0}" label="Out of service" symbol="0" filter="&quot;status&quot; &lt;&gt; 'in_operation'" />
                <rule key="{r1}" label="HVDC" symbol="1" filter="&quot;hvdc&quot; = 1" />
                <rule key="{r2}" label="380 kV (route not mapped: dotted)" symbol="2" filter="&quot;status&quot; = 'in_operation' AND &quot;hvdc&quot; = 0 AND &quot;voltage_kv&quot; &gt;= 300 AND &quot;route_quality&quot; IN ('straight', 'unrouted')" />
                <rule key="{r3}" label="380 kV" symbol="3" filter="&quot;status&quot; = 'in_operation' AND &quot;hvdc&quot; = 0 AND &quot;voltage_kv&quot; &gt;= 300 AND &quot;route_quality&quot; NOT IN ('straight', 'unrouted')" />
